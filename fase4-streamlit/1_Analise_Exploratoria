import streamlit as st
import seaborn as sns
import numpy as np
import pandas as pd
import matplotlib.pyplot as plt
import plotly.express as px


st.title("📊 Análise Exploratória dos Dados")

st.set_page_config(
    page_title="Análise Exploratória",
    page_icon="📊"
)

# ================================================
# 1. Carregar os Dados
# ================================================

st.header("1. Carregar os Dados")

# Carregar o dataset

@st.cache_data(show_spinner=True)
def load_data():
    return pd.read_csv("produtos_agricolas.csv")

df = load_data()

st.write("Primeiras linhas do dataset:")
st.dataframe(df.head())


# ================================================
# 2. Visão Geral dos Dados
# ================================================

st.header("2. Visão Geral dos Dados")

#informações sobre o DataFrame
st.write(f'Linhas: {df.shape[0]}')
st.write(f'Colunas: {df.shape[1]}')
st.write(df.dtypes)

# Estatísticas Descritivas
st.subheader('Estatísticas Descritivas')
st.write(df.describe())

# ================================================
# 3. Análise de Correlação
# ================================================

st.header('3. Análise de Correlação')

# Mapa de calor de correlação
st.subheader('Mapa de Calor de Correlação')

# Selecionar apenas colunas numéricas
numeric_df = df.select_dtypes(include=[np.number])
corr = numeric_df.corr()

fig_heatmap, ax = plt.subplots(figsize=(10, 8))
sns.heatmap(corr, annot=True, cmap='coolwarm', ax=ax)
st.pyplot(fig_heatmap)


st.subheader("Gráfico de Dispersão Interativo")

numeric_columns = [
    "N",
    "P",
    "K",
    "temperature",
    "humidity",
    "ph",
    "rainfall"
]

x_var = st.selectbox("Escolha a variável X", numeric_columns)
y_var = st.selectbox("Escolha a variável Y", numeric_columns)

fig = px.scatter(
    df,
    x=x_var,
    y=y_var,
    title=f"{y_var} vs {x_var}"
)

st.plotly_chart(fig, use_container_width=True)
